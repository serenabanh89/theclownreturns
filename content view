import SwiftUI

struct Creature {
    var sdmg : Int
    var bdmg : Int
    var def : Int
    var health : Int
    var speed : Int
}//this is what each amalgam will be, all have to have these stats

var tempUp = 0

struct ContentView: View {
    
    @State var animals = ["Dragon", "Werewolf", "Phoenix", "Rabbit"]    
    @State var earSelected = ""
    @State var headSelected = ""
    @State var armSelected = ""
    @State var bodySelected = ""
    @State var legSelected = ""

    @State var player: Creature 
    
    func setEars() {
        if earSelected == "Dragon" {
            tempUp = 1
        } else if earSelected == "Werewolf" {
            tempUp = 2
        } else if earSelected == "Phoenix" {
            tempUp = 3
        } else if earSelected == "Rabbit" {
            tempUp = 4
        }
    }//called in Go! button
    
    var body: some View {
        HStack {
        VStack {
            //EARS
            HStack {
                Text("Ears")
                    Picker("Please choose ears", selection: $earSelected) {
                        ForEach(animals, id: \.self) {
                            Text($0)
                        }
                    }
                    .pickerStyle(.palette)
                //functionality taken care of in Go! button
            }
            
            //HEAD
            HStack {
                Text("Head")
                    Picker("Please choose a head", selection: $headSelected) {
                        ForEach(animals, id: \.self) {
                            Text($0)
                        }
                    }
                    .pickerStyle(.palette)
                //controls base 'basic' damage stat
                    .onChange(of: headSelected) { 
                        if headSelected == "Dragon" {
                            player.bdmg = 13
                        } else if headSelected == "Werewolf" {
                            player.bdmg = 19
                        } else if headSelected == "Phoenix" {
                            player.bdmg = 10
                        } else if headSelected == "Rabbit" {
                            player.bdmg = 16
                        }
                    }
                
            }
            
            //ARMS
            HStack {
                Text("Arms")
                Picker("Please choose arms", selection: $armSelected) {
                    ForEach(animals, id: \.self) {
                        Text($0)
                    }
                }
                .pickerStyle(.palette)
                //controls base health bar
                .onChange(of: armSelected) { 
                    if armSelected == "Dragon" {
                        player.health = 90
                    } else if armSelected == "Werewolf" {
                        player.health = 80
                    } else if armSelected == "Phoenix" {
                        player.health = 100
                    } else if armSelected == "Rabbit" {
                        player.health = 70
                    }
                }
            }
            //BODY
            HStack {
                Text("Body")
                Picker("Please choose a body", selection: $bodySelected) {
                    ForEach(animals, id: \.self) {
                        Text($0)
                    }
                }
                .pickerStyle(.palette)
                //controls base defense stat
                .onChange(of: bodySelected) { 
                    if bodySelected == "Dragon" {
                        player.def = 20
                    } else if bodySelected == "Werewolf" {
                        player.def = 11
                    } else if bodySelected == "Phoenix" {
                        player.def = 16
                    } else if bodySelected == "Rabbit" {
                        player.def = 13
                    }
                }
            }
            //LEGS
            HStack {
                Text("Legs")
                Picker("Please choose arms", selection: $legSelected) {
                    ForEach(animals, id: \.self) {
                        Text($0)
                    }
                }
                .pickerStyle(.palette)
                //controls base 'special' damage stat
                .onChange(of: legSelected) { 
                    if legSelected == "Dragon" {
                        player.sdmg = 11
                    } else if legSelected == "Werewolf" {
                        player.sdmg = 17
                    } else if legSelected == "Phoenix" {
                        player.sdmg = 14
                    } else if legSelected == "Rabbit" {
                        player.sdmg = 20
                    }
                }
            }
        }.frame(width: 500)
            
            VStack {
                Text("Basic damage: \(player.bdmg)\nSpecial Damage: \(player.sdmg)\nDefense: \(player.def)\nHealth: \(player.health)\nSpeed: \(player.speed)")
                    .frame(width: 200)
            }
        }
        
        Button(action: {
            if tempUp == 1 {
                player.sdmg += 5
            } else if tempUp == 2 {
                player.bdmg += 5
            } else if tempUp == 3 {
                player.health += 5
            } else if tempUp == 4 {
                player.speed += 5
            }
            tempUp = 0
            setEars()
            earSelected = ""
        }, label: {
            Text("Go!")
            //ALSO NEEDS TO NAVIGATE TO FIGHT VIEW
        })
        
    }
}



